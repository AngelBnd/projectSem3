datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// entities

model Users {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  products Products[]
  invoices Invoices[]
}

model Products {
  productCode String @id

  productName     String
  productCategory String
  productBrand    String

  sellingPrice Decimal @db.Decimal(10, 2)
  unitCost     Decimal @db.Decimal(10, 2)

  initialStock   Int @default(0)
  thresholdStock Int @default(0)

  // DEFINING FK
  userId Int
  user   Users @relation(fields: [userId], references: [id])

  lastUpdated DateTime @updatedAt

  lineItems LineItems[] // Products can be on many LineItems
  // stockAdjustments StockAdjustment[] 
}

model Invoices {
  invoiceId String @id

  invoiceDate DateTime @default(now())

  subject String

  paymentMethod   String
  invoiceSubtotal Decimal @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)
  discountPrice   Decimal @db.Decimal(10, 2)

  // DEFINING FK
  userId Int
  user   Users @relation(fields: [userId], references: [id])

  lineItems LineItems[]
}

model LineItems {
  invoiceId String
  invoice   Invoices @relation(fields: [invoiceId], references: [invoiceId])

  productCode String
  product     Products @relation(fields: [productCode], references: [productCode])

  quantitySold Int

  sellingPrice Decimal @db.Decimal(10, 2)

  lineSubtotal Decimal @db.Decimal(10, 2)

  @@id([productCode, invoiceId])
}
