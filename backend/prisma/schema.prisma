datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
  
// Workflow / approval status for products
enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Business status for products
enum ProductStatus {
  ACTIVE
  INACTIVE
}

// Business / payment / delivery status for invoices
enum InvoiceStatus {
  PENDING     // waiting for payment
  DELIVERED   // goods delivered
  COMPLETED   // fully paid
  CANCELLED   // invoice cancelled
}

// Workflow / approval status for invoices (optional if admin approval is needed)
enum InvoiceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Store {
  id         Int        @id @default(autoincrement())
  name       String
  storeTag   String     @unique
  ownerId    Int?        @unique
  owner      User?       @relation("StoreOwner", fields: [ownerId], references: [id])

  users      User[]     @relation("StoreUsers")
  products   Product[]
  invoices   Invoice[]
  createdAt  DateTime   @default(now())
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  username    String    @unique

  // Role
  roleId      Int
  role        Role      @relation(fields: [roleId], references: [id])

  // Store membership
  storeId     Int
  store       Store @relation("StoreUsers", fields: [storeId], references: [id])

  ownedStore Store? @relation("StoreOwner")
  createdProducts Product[] @relation("UserCreatedProducts")
  createdInvoices Invoice[] @relation("UserCreatedInvoices")
  createdVariants ProductVariant[] @relation("UserCreatedVariants")

  createdAt   DateTime  @default(now())
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  users           User[]           
}

model Permission {
  id              Int               @id @default(autoincrement())
  entity          String           
  action          String            
  description     String?        
  rolePermissions RolePermission[]

  @@unique([entity, action])        // ensures no duplicate permissions for the same entity/action
}
model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int

  @@id([roleId, permissionId])
}

model Product {
  id          Int       @id @default(autoincrement()) 
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])


  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  brandId     Int
  brand       Brand     @relation(fields: [brandId], references: [id])

  name        String
  type        String
  description String?
  status         ProductStatus        @default(INACTIVE)          // business status
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById Int
  createdBy   User @relation("UserCreatedProducts", fields: [createdById], references: [id])

  variants    ProductVariant[]
}

model ProductVariant {
  id          Int      @id @default(autoincrement()) 
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  sku         String    @unique
  barcode     String?   @unique
  sellingPrice Decimal  @db.Decimal(10, 2)
  status         ProductStatus        @default(INACTIVE)          // business status
  approvalStatus ProductApprovalStatus @default(PENDING)          // workflow status

  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())

  createdById Int
  createdBy   User @relation("UserCreatedVariants", fields: [createdById], references: [id])

  lineItems  LineItem[] @relation("VariantLineItems", fields: [], references: [])
  @@unique([productId, isDefault])
}

model Brand {
  id    Int     @id @default(autoincrement())
  name  String  @unique 
  products Product[]
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  products Product[]
}


model Invoice {
  id              Int       @id @default(autoincrement())
  invoiceId       String    @unique

  invoiceDate     DateTime  @default(now())
  name            String
  subject         String
  paymentMethod   String

  invoiceSubtotal Decimal   @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  discountPrice   Decimal   @db.Decimal(10, 2)

  // FK to User who made it
  createdBy   Int
  user      User @relation("UserCreatedInvoices", fields: [createdBy], references: [id])

  // FK to Store
  storeId         Int
  store           Store     @relation(fields: [storeId], references: [id])

  lineItems       LineItem[]
}

model LineItem {
  id            Int        @id @default(autoincrement())

  invoiceId     String
  invoice       Invoice    @relation(fields: [invoiceId], references: [invoiceId])

  sku           String
  productVariant ProductVariant @relation("VariantLineItems", fields: [sku], references: [sku])

  quantitySold  Int
  sellingPrice  Decimal    @db.Decimal(10, 2)
  lineSubtotal  Decimal    @db.Decimal(10, 2)

  @@unique([sku, invoiceId])
}