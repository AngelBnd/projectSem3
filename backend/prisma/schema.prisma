// --------------------------------------
// DATABASE + GENERATOR
// --------------------------------------
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------
// ENUMS
// --------------------------------------
enum UserStoreStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StockReferenceType {
  INVOICE
  PURCHASE_ORDER
  PURCHASE_RETURN
  ADJUSTMENT
  SALES_ORDER
  SALES_RETURN
}

enum StockAuditStatus {
  PENDING
  PENDING_APPROVAL
  COMPLETED
  APPROVED
  REJECTED
}

enum ProductCategory {
  HEAD_UNITS
  SPEAKERS
  AMPLIFIERS
  SUBWOOFERS
  WIRING_ACCESSORIES
  SIGNAL_PROCESSORS
  BLUETOOTH_MODULES
  BACKUP_CAMERAS
  CARPLAY_ANDROIDAUTO
  DASH_KITS
  INSTALLATION_ACCESSORIES
  SOUND_DEADENING
  BATTERIES_POWER
  LIGHTING_ACCESSORIES
  SECURITY_SYSTEMS
  RADAR_DETECTORS
}

enum ProductBrand {
  PIONEER
  ALPINE
  KENWOOD
  JVC
  SONY
  JBL
  KICKER
  ROCKFORD_FOSGATE
  AUDIOCONTROL
  MTX
  INFINITY
  JL_AUDIO
  BOSS_AUDIOSYSTEMS
  DS18
  NVX
  STINGER
  CRUCHFIELD
  METRA
  SCOSCHE
  PAC
}

enum StockAdjustmentReason {
  DAMAGED
  MISCOUNT
  SUPPLIER_ERROR
  UNRECORDED_SALE
  UNRECORDED_RECEIPT
  OTHER
}

enum PurchaseReturnStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum SalesOrderCreationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SalesOrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SalesOrderDeliveryStatus {
  UNDELIVERED
  PARTIALLY_DELIVERED
  DELIVERED
}

enum SalesReturnStatus {
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  APPLIED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum InvoiceStatus {
  DRAFT             
  PENDING_APPROVAL    
  APPROVED           
  REJECTED           

  ISSUED           
  PARTIALLY_PAID   
  PAID             

  OVERDUE          
  CANCELLED     
  VOIDED          
}

// --------------------------------------
// STORES (TENANT ROOT)
// --------------------------------------
model Stores {
  storeId     Int      @id @default(autoincrement())
  storeTag    String   @unique
  storeName   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     Int      @unique
  owner       Users    @relation("StoreOwner", fields: [ownerId], references: [userId])

  users                 Users[]
  roles                 Roles[]
  products              Products[]
  productVariants       ProductVariants[]

  purchaseOrders        PurchaseOrders[]
  purchaseOrderItems    PurchaseOrderItems[]
  purchaseReturns       PurchaseReturns[]
  purchaseReturnItems   PurchaseReturnItems[]
  receivedGoodsNotes    ReceivedGoodsNotes[]

  salesOrders           SalesOrders[]

  invoices              Invoices[]
  invoiceLineItems      InvoiceLineItems[]
  creditNotes           CreditNotes[]
  creditNoteItems       CreditNoteItems[]

  stockAudits           StockAudits[]
  stockMovements        StockMovements[]

  attributes            Attributes[]
  attributeValues       AttributeValues[]
  productVariantAttributes ProductVariantAttributes[]

  auditLogs             AuditLogs[]
}

// --------------------------------------
// USERS & ROLES & PERMISSIONS (RBAC)
// --------------------------------------
model Users {
  userId       Int     @id @default(autoincrement())
  storeId      Int?    
  store        Stores? @relation(fields: [storeId], references: [storeId])
  
  firstName    String @default("")
  lastName     String @default("")
  email        String   @unique
  phoneNumber  String?  

  passwordHash String
  status       UserStoreStatus @default(PENDING_APPROVAL)
  requestedStoreTag String?
  requestedAt   DateTime @default(now())
  approvedAt    DateTime?
  approvedBy    Int? 
  
  approvedByUser Users? @relation("ApprovedBy", fields: [approvedBy], references: [userId])
  
  approvedUsers Users[] @relation("ApprovedBy")
  
  ownedStore   Stores? @relation("StoreOwner")
  
  userRoles    UserRoles[]
  
  productsCreated Products[]
  stockAudits  StockAudits[]
  creditNotes  CreditNotes[]
  auditLogs     AuditLogs[]
  salesOrders   SalesOrders[]

  @@index([storeId])
  @@index([status])
  @@index([requestedStoreTag])
}


model Roles {
  roleId     Int    @id @default(autoincrement())
  storeId    Int
  store      Stores @relation(fields: [storeId], references: [storeId])
  roleName   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Opposite relations
  userRoles  UserRoles[]
  rolePermissions RolePermissions[]

  @@index([storeId])
}

model Permissions {
  permissionId  Int     @id @default(autoincrement())
  module        String
  permission    String

  @@unique([module, permission])

  rolePermissions RolePermissions[]
}

model RolePermissions {
  rolePermissionId Int @id @default(autoincrement())
  roleId           Int
  permissionId     Int

  role       Roles       @relation(fields: [roleId], references: [roleId])
  permission Permissions @relation(fields: [permissionId], references: [permissionId])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoles {
  userRoleId Int  @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  isPrimary  Boolean  @default(false)

  user       Users @relation(fields: [userId], references: [userId])
  role       Roles @relation(fields: [roleId], references: [roleId])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// --------------------------------------
// PRODUCTS 
// --------------------------------------
model Products {
  productId         Int @id @default(autoincrement())
  storeId           Int
  store             Stores @relation(fields: [storeId], references: [storeId])
  productName       String
  productDescription String?
  productStatus     ProductStatus
  approvalStatus    ApprovalStatus
  category          ProductCategory
  brand             ProductBrand
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants          ProductVariants[]
  createdBy         Int
  createdByUser     Users @relation(fields: [createdBy], references: [userId])

  @@index([storeId])
  @@index([createdBy])
}

model ProductVariants {
  productVariantId Int @id @default(autoincrement())
  storeId          Int
  store            Stores   @relation(fields: [storeId], references: [storeId])
  productId        Int
  product          Products  @relation(fields: [productId], references: [productId])
  sku              String
  barcode          String?
  sellingPrice     Decimal @default(0)
  isDefault        Boolean @default(false)
  thresholdStock   Int @default(0)
  productStatus    ProductStatus
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  image            String?

  salesOrderItems        SalesOrderItems[]
  purchaseOrderItems     PurchaseOrderItems[]
  receivedGoodsNotes     ReceivedGoodsNotes[]
  purchaseReturnItems    PurchaseReturnItems[]
  stockMovements         StockMovements[]
  productVariantAttributes ProductVariantAttributes[]
  stockAdjustmentPerProduct StockAdjustmentPerProduct[]
  invoiceLineItems      InvoiceLineItems[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([productId])
}

model Attributes {
  attributeId        Int @id @default(autoincrement())
  storeId            Int
  store              Stores @relation(fields: [storeId], references: [storeId])
  name               String

  attributeValues    AttributeValues[]

  @@index([storeId])
}

model AttributeValues {
  attributeValuesId  Int @id @default(autoincrement())
  attributeId        Int
  valueName          String
  storeId            Int
  store              Stores @relation(fields: [storeId], references: [storeId])
  attribute          Attributes @relation(fields: [attributeId], references: [attributeId], onDelete: Cascade)
  productVariantAttributes ProductVariantAttributes[]

  @@index([attributeId])
  @@index([storeId])
}

model ProductVariantAttributes {
  productVariantAttributeId Int @id @default(autoincrement())
  attributeValuesId         Int
  productVariantsId         Int
  storeId                   Int
  store                     Stores @relation(fields: [storeId], references: [storeId])
  attributeValue            AttributeValues @relation(fields: [attributeValuesId], references: [attributeValuesId], onDelete: Cascade)
  productVariant            ProductVariants @relation(fields: [productVariantsId], references: [productVariantId], onDelete: Cascade)

  @@unique([attributeValuesId, productVariantsId])
  @@index([storeId])
  @@index([attributeValuesId])
  @@index([productVariantsId])
}


// --------------------------------------
// INVENTORY MANAGEMENT
// --------------------------------------

model StockMovements {
  stockMovementId   Int @id @default(autoincrement())
  storeId           Int
  store             Stores @relation(fields: [storeId], references: [storeId])
  productVariantId  Int
  productVariant    ProductVariants @relation(fields: [productVariantId], references: [productVariantId])
  referenceId       Int
  referenceType     StockReferenceType
  change            Int 
  reason            String
  createdAt         DateTime @default(now())

  @@index([storeId])
  @@index([productVariantId])
  @@index([referenceType])
  @@index([createdAt])
}

model StockAudits {
  auditId         Int @id @default(autoincrement())
  storeId         Int
  store           Stores @relation(fields: [storeId], references: [storeId])
  doneBy          Int
  doneByUser      Users @relation(fields: [doneBy], references: [userId])
  status          StockAuditStatus
  auditDate       DateTime @default(now())
  difference      Int
  notes           String

  stockAdjustmentPerProduct StockAdjustmentPerProduct[]

  @@index([storeId])
  @@index([doneBy])
  @@index([auditDate])
  @@index([status])
}

model StockAdjustmentPerProduct {
  stockAdjustmentPerProductId Int @id @default(autoincrement())
  productVariantId  Int
  productVariant    ProductVariants @relation(fields: [productVariantId], references: [productVariantId])
  auditId           Int
  audit             StockAudits @relation(fields: [auditId], references: [auditId])
  physicalQuantity  Int
  systemQuantity    Int
  reason            StockAdjustmentReason

  @@index([productVariantId])
  @@index([auditId])
  @@index([reason])
}

// --------------------------------------
// INVOICES
// --------------------------------------
model Invoices {
  invoiceId        Int @id @default(autoincrement())
  storeId          Int
  store            Stores @relation(fields: [storeId], references: [storeId])
  salesOrderId     Int? @unique  
  invoiceNumber    String @unique
  invoiceType      String
  invoiceSubject   String?
  invoiceDate      DateTime
  discount         Decimal?
  subtotal         Decimal
  totalAmount      Decimal
  status           InvoiceStatus 

  invoiceLineItems InvoiceLineItems[]
  creditNotes      CreditNotes[]
  salesOrder       SalesOrders? @relation(fields: [salesOrderId], references: [salesOrderId])

  @@index([storeId])
  @@index([salesOrderId])
  @@index([invoiceDate])
}

model InvoiceLineItems {
  invoiceLineItemsId Int @id @default(autoincrement())
  invoiceId          Int
  invoice            Invoices @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  productVariantsId  Int
  productVariant     ProductVariants @relation(fields: [productVariantsId], references: [productVariantId], onDelete: Cascade)
  storeId            Int
  store              Stores @relation(fields: [storeId], references: [storeId])
  desc               String?
  servicePrice       Decimal?
  serviceDesc        String?
  quantitySold       Int
  sellingPrice       Decimal

  creditNoteItems    CreditNoteItems[]

  @@index([invoiceId])
  @@index([productVariantsId])
  @@index([storeId])
}

model Channels {
  channelId      Int @id @default(autoincrement())
  name           String
  subChannels    SubChannels[]
  salesOrders    SalesOrders[]

}

model SubChannels {
  subChannelId   Int @id @default(autoincrement())
  channelId      Int
  subChannelName String
  channel        Channels @relation(fields: [channelId], references: [channelId], onDelete: Cascade)

  salesOrders    SalesOrders[]
  @@index([channelId])
}

// --------------------------------------
// PURCHASING FROM SUPPLIERS 
// --------------------------------------
model PurchaseOrders {
  purchaseOrderId      Int @id @default(autoincrement())
  storeId              Int
  store                Stores @relation(fields: [storeId], references: [storeId])
  supplierName         String
  orderDate            DateTime
  expectedArrivalDate  DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  totalCost            Decimal?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items                PurchaseOrderItems[]
  receivedGoodsNotes   ReceivedGoodsNotes[]
  purchaseReturns      PurchaseReturns[]

  @@index([storeId])
  @@index([orderDate])
}

model PurchaseOrderItems {
  purchaseOrderItemId Int @id @default(autoincrement())
  purchaseOrderId     Int
  productVariantId    Int
  storeId             Int
  store               Stores @relation(fields: [storeId], references: [storeId])
  purchaseOrder       PurchaseOrders @relation(fields: [purchaseOrderId], references: [purchaseOrderId])
  productVariant      ProductVariants @relation(fields: [productVariantId], references: [productVariantId])
  quantityOrdered     Int
  costPrice           Decimal
  discount            Decimal?
  tax                 Decimal?

  @@index([purchaseOrderId])
  @@index([productVariantId])
  @@index([storeId])
}

model ReceivedGoodsNotes {
  receivedGoodsNoteId Int @id @default(autoincrement())
  purchaseOrderId     Int
  productVariantId    Int
  storeId             Int
  store               Stores @relation(fields: [storeId], references: [storeId])
  qtyReceived         Int
  dateReceived        DateTime @default(now())
  purchaseOrder       PurchaseOrders @relation(fields: [purchaseOrderId], references: [purchaseOrderId])
  productVariant      ProductVariants @relation(fields: [productVariantId], references: [productVariantId])

  @@index([purchaseOrderId])
  @@index([productVariantId])
  @@index([storeId])
}

model PurchaseReturns {
  purchaseReturnId Int @id @default(autoincrement())
  purchaseOrderId  Int
  storeId          Int
  store            Stores @relation(fields: [storeId], references: [storeId])
  dateReturned     DateTime @default(now())
  status           PurchaseReturnStatus
  reason           String?
  purchaseOrder    PurchaseOrders @relation(fields: [purchaseOrderId], references: [purchaseOrderId])
  returnItems      PurchaseReturnItems[]

  @@index([purchaseOrderId])
  @@index([storeId])
}

model PurchaseReturnItems {
  purchaseReturnItemId Int @id @default(autoincrement())
  purchaseReturnId     Int
  productVariantId     Int
  storeId              Int
  store                Stores @relation(fields: [storeId], references: [storeId])
  qtyReturned          Int
  reason               String?
  purchaseReturn       PurchaseReturns @relation(fields: [purchaseReturnId], references: [purchaseReturnId])
  productVariant       ProductVariants @relation(fields: [productVariantId], references: [productVariantId])

  @@index([purchaseReturnId])
  @@index([productVariantId])
  @@index([storeId])
}

// --------------------------------------
// SALE ORDERS AND ALL ITS FRIENDS
// --------------------------------------
model SalesOrders {
  salesOrderId   Int      @id @default(autoincrement())
  storeId        Int
  customerName   String?
  orderDate      DateTime
  paymentStatus  SalesOrderPaymentStatus  @default(UNPAID)
  deliveryStatus SalesOrderDeliveryStatus @default(UNDELIVERED)
  creationStatus SalesOrderCreationStatus @default(DRAFT)
  paymentTerms   String?
  createdBy      Int
  totalAmount    Decimal
  discount       Decimal?
  channelId      Int?
  subChannelId   Int?

  subChannel      SubChannels? @relation(fields : [subChannelId], references: [subChannelId])
  channel          Channels? @relation(fields: [channelId], references: [channelId])
  createdByUser    Users @relation(fields: [createdBy], references: [userId])
  invoice        Invoices?
  store          Stores @relation(fields: [storeId], references: [storeId])
  items          SalesOrderItems[]

  @@index([channelId])
  @@index([subChannelId])
}

model SalesOrderItems {
  salesOrderItemsId Int @id @default(autoincrement())

  salesOrderId      Int
  productVariantId Int?

  quantityOrdered   Int
  unitPrice         Decimal

  serviceDesc       String? 

  salesOrder        SalesOrders       @relation(fields: [salesOrderId], references: [salesOrderId])
  productVariant    ProductVariants?  @relation(fields: [productVariantId], references: [productVariantId])
  deliveries      SalesDeliveryItems[]
}

model SalesDeliveryItems {
  salesDeliveryItemsId  Int @id @default(autoincrement())
  salesOrderItemsId       Int
  quantityDelivered       Int
  deliveryDate         DateTime

  salesOrderItem          SalesOrderItems @relation(fields: [salesOrderItemsId], references: [salesOrderItemsId])
  returns                 SalesReturnItems[]
}

model SalesReturnItems {
  salesReturnItemsId     Int @id @default(autoincrement())

  salesDeliveryItemsId Int
  qtyReturned              Int
  status                   SalesReturnStatus @default(PROCESSING)
  returnDate               DateTime

  salesDeliveryItem     SalesDeliveryItems @relation(fields: [salesDeliveryItemsId], references: [salesDeliveryItemsId])
}

// --------------------------------------
// CREDIT NOTES
// --------------------------------------
model CreditNotes {
  creditNoteId      Int @id @default(autoincrement())
  invoiceId         Int
  storeId           Int
  creditNoteNumber  String @unique
  dateIssued        DateTime
  reason            String?
  totalAmount       Decimal
  status            CreditNoteStatus @default(DRAFT)
  createdBy         Int

  invoice           Invoices @relation(fields: [invoiceId], references: [invoiceId])
  store             Stores @relation(fields: [storeId], references: [storeId])
  createdByUser     Users @relation(fields: [createdBy], references: [userId])
  creditNoteItems   CreditNoteItems[]

  @@index([invoiceId])
  @@index([storeId])
  @@index([dateIssued])
  @@index([status])
  @@index([createdBy])
}

model CreditNoteItems {
  creditNoteItemsId Int @id @default(autoincrement())
  creditNoteId      Int
  invoiceLineItemsId Int
  storeId           Int
  store             Stores @relation(fields: [storeId], references: [storeId])
  qtyCredited       Int
  unitPrice         Decimal
  amount            Decimal

  creditNote        CreditNotes @relation(fields: [creditNoteId], references: [creditNoteId], onDelete: Cascade)
  invoiceLineItem   InvoiceLineItems @relation(fields: [invoiceLineItemsId], references: [invoiceLineItemsId], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([invoiceLineItemsId])
  @@index([storeId])
}

model AuditLogs {
  auditLogId   Int       @id @default(autoincrement())
  storeId      Int?
  store        Stores?   @relation(fields: [storeId], references: [storeId])

  userId       Int?
  user         Users?    @relation(fields: [userId], references: [userId])

  tableName    String
  recordId     Int
  action       String           
  oldValue     Json?
  newValue     Json?

  ipAddress    String?
  userAgent    String?

  createdAt    DateTime @default(now())

  @@index([storeId])
  @@index([userId])
  @@index([tableName])
  @@index([action])
}
