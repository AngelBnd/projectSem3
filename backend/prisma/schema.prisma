datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// entities

model Users {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  products Products[]
  invoices Invoices[]
}

model Products {
  id Int @id @default(autoincrement())
  productCode String @unique

  productName     String
  productCategory String
  productBrand    String

  sellingPrice Decimal @db.Decimal(10, 2)
  unitCost     Decimal @db.Decimal(10, 2)

  initialStock   Int @default(0)
  thresholdStock Int @default(0)

  // DEFINING FK
  userId Int
  user   Users @relation(fields: [userId], references: [id])

  lastUpdated DateTime @updatedAt

  lineItems LineItems[] // Products can be on many LineItems
  // stockAdjustments StockAdjustment[] 
}

model Invoices {
  id Int @id @default(autoincrement())
  invoiceId String @unique

  invoiceDate DateTime @default(now())

  subject String

  paymentMethod   String
  invoiceSubtotal Decimal @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)
  discountPrice   Decimal @db.Decimal(10, 2)

  // DEFINING FK
  userId Int
  user   Users @relation(fields: [userId], references: [id])

  lineItems LineItems[]
}

model LineItems {
  id Int @id @default(autoincrement())
  invoiceId Int
  invoice   Invoices @relation(fields: [invoiceId], references: [id])

  productCode Int
  product     Products @relation(fields: [productCode], references: [id])

  quantitySold Int

  sellingPrice Decimal @db.Decimal(10, 2)

  lineSubtotal Decimal @db.Decimal(10, 2)

  @@unique([productCode, invoiceId])
}
