# Database connection — update username/password/db name to match your local MySQL
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/inventory_db"

# Secret used to sign/verify JWT tokens. Auto-generated below — keep this private, never commit it.
JWT_SECRET="XX"

# Set to true to skip authentication during local debugging (used in middleware/auth.js). Leave false normally.
BYPASS_AUTH=false
